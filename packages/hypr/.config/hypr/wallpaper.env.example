# wallpaper.env — contoh konfigurasi untuk wallpaper-rotate.sh
# Salin file ini menjadi `wallpaper.env` di folder yang sama, lalu isi kuncinya:
#   cp ~/.config/hypr/wallpaper.env.example ~/.config/hypr/wallpaper.env
# File `wallpaper.env` (yang asli, berisi kunci) JANGAN di-commit — sudah ada di .gitignore.
#
# Cara dapat Access Key:
#   1. Buka https://unsplash.com/developers
#   2. Buat aplikasi baru (New Application), isi nama + deskripsi.
#   3. Salin "Access Key"-nya ke UNSPLASH_ACCESS_KEY di bawah.

# Access Key dari https://unsplash.com/developers (wajib)
UNSPLASH_ACCESS_KEY=

# Tema foto (opsional, default: dark landscape)
UNSPLASH_QUERY="dark landscape"

# Ukuran gambar yang diunduh (opsional, default: 1920x1080)
WALLPAPER_WIDTH=1920
WALLPAPER_HEIGHT=1080
