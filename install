#!/usr/bin/env bash
# Symlink packages from ./packages into $HOME with GNU Stow.
#   ./install              stow every package
#   ./install sway waybar  stow only the named packages
#   ./install -n sway      extra flags are passed to stow (-n = dry run)
# Target dir and folding behaviour come from .stowrc.

set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

flags=()
pkgs=()
for arg in "$@"; do
  if [[ $arg == -* ]]; then flags+=("$arg"); else pkgs+=("$arg"); fi
done

if ((${#pkgs[@]} == 0)); then
  for dir in packages/*/; do
    pkgs+=("$(basename "$dir")")
  done
fi

mkdir -p "$HOME/.vim/undo-history"

stow --restow "${flags[@]}" "${pkgs[@]}"
