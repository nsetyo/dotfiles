#!/usr/bin/env bash
# Symlink packages from ./packages into $HOME with GNU Stow.
#   ./install              stow every package
#   ./install hypr quickshell  stow only the named packages
#   ./install -n hypr      dry run
#   ./install -D hypr      unstow
# Dash-prefixed arguments are passed to stow; write options that take a value
# as --opt=value. Target dir and folding behaviour come from .stowrc.

set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

flags=()
pkgs=()
for arg in "$@"; do
  if [[ $arg == -* ]]; then
    flags+=("$arg")
  else
    pkgs+=("$arg")
  fi
done

if ((${#pkgs[@]} == 0)); then
  for dir in packages/*/; do
    dir=${dir%/}
    pkgs+=("${dir#packages/}")
  done
fi

stow ${flags[@]+"${flags[@]}"} "${pkgs[@]}"
