#!/usr/bin/env bash
# Symlink packages from ./packages into $HOME with GNU Stow.
#   ./install              stow every package
#   ./install sway waybar  stow only the named packages
#   ./install -n sway      dry run
#   ./install -D sway      unstow
# Dash-prefixed arguments are passed to stow; write options that take a value
# as --opt=value. Target dir and folding behaviour come from .stowrc.

set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

flags=()
pkgs=()
dry_run=false
for arg in "$@"; do
  if [[ $arg == -* ]]; then
    flags+=("$arg")
    [[ $arg == -n || $arg == --no || $arg == --simulate ]] && dry_run=true
  else
    pkgs+=("$arg")
  fi
done

if ((${#pkgs[@]} == 0)); then
  for dir in packages/*/; do
    dir=${dir%/}
    pkgs+=("${dir#packages/}")
  done
fi

$dry_run || mkdir -p "$HOME/.vim/undo-history"

stow ${flags[@]+"${flags[@]}"} "${pkgs[@]}"
